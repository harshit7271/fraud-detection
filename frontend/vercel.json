{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/register",
      "destination": "/pages/register.html"
    },
    {
      "source": "/monitor",
      "destination": "/pages/monitor.html"
    },
    {
      "source": "/history",
      "destination": "/pages/history.html"
    },
    {
      "source": "/session-details",
      "destination": "/pages/session-details.html"
    },
    {
      "source": "/settings",
      "destination": "/pages/settings.html"
    },
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://harshit7271-faceguard-ai.hf.space/api/v1/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://harshit7271-faceguard-ai.hf.space/healthz"
    }
  ]
}
