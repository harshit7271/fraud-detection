{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://harshit7271-faceguard-ai.hf.space/api/v1/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://harshit7271-faceguard-ai.hf.space/healthz"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/monitor",
      "destination": "/monitor.html"
    },
    {
      "source": "/history",
      "destination": "/history.html"
    },
    {
      "source": "/session-details",
      "destination": "/session-details.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/performance-report",
      "destination": "/performance-report.html"
    },
    {
      "source": "/pages/register",
      "destination": "/register.html"
    },
    {
      "source": "/pages/monitor",
      "destination": "/monitor.html"
    },
    {
      "source": "/pages/history",
      "destination": "/history.html"
    },
    {
      "source": "/pages/session-details",
      "destination": "/session-details.html"
    },
    {
      "source": "/pages/settings",
      "destination": "/settings.html"
    }
  ]
}
