# Application Configuration
APP_NAME="Blink Face Fraud Detection Microservice"
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Security & Biometrics
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt"
# 32-byte (256-bit) base64-encoded key for AES-256-GCM embedding encryption
BIOMETRIC_MASTER_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
BIOMETRIC_KEY_VERSION="v1-2026"
ALLOWED_ORIGINS='["http://localhost:3000","https://interview.blinkcloud.ai"]'

# Database (PostgreSQL 16)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="face_fraud_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/face_fraud_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/face_fraud_db"

# Redis & Background Workers
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Computer Vision Models
YUNET_MODEL_PATH="models/weights/face_detection_yunet_2023mar.onnx"
SFACE_MODEL_PATH="models/weights/face_recognition_sface_2021dec.onnx"
CV_CONFIDENCE_THRESHOLD=0.30
CV_NMS_THRESHOLD=0.30
CV_MIN_FACE_SIZE=30

# Default Proctoring Thresholds (Fallback if not overridden by TenantConfig)
DEFAULT_FACE_MATCH_THRESHOLD=0.38
DEFAULT_FACE_UNCERTAIN_THRESHOLD=0.25
DEFAULT_MULTIPLE_FACES_DEBOUNCE_MS=2000
DEFAULT_FACE_ABSENT_DEBOUNCE_MS=3000

# Observability
SENTRY_DSN=""
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL="INFO"
